    m_PersistentCalls:
      m_Calls: []
  m_text: "Hi\u1EC7n v\u1EADt n\xE0y c\xF3 th\xE2n h\xECnh tr\u1EE5 h\u01A1i ph\xECnh,
    c\u1ED5 th\u1EAFt v\xE0 mi\u1EC7ng loe, v\u1EDBi c\xE1c h\u1ECDa ti\u1EBFt trang
    tr\xED n\u1ED5i h\xECnh hoa sen ho\u1EB7c h\xECnh tr\xF2n \u0111\u1EB7c tr\u01B0ng.
    Ch\u1EA5t li\u1EC7u g\u1ED1m c\u1EE9ng, men ph\u1EE7 b\xF3ng t\u1EA1o \u0111\u1ED9
    s\xE2u v\xE0 hi\u1EC7u \u1EE9ng m\xE0u s\u1EAFc \u0111\u1EB7c bi\u1EC7t d\u01B0\u1EDBi
    \xE1nh s\xE1ng. \u0110\xE2y l\xE0 m\u1ED9t minh ch\u1EE9ng cho tr\xECnh \u0111\u1ED9
    ph\xE1t tri\u1EC3n cao c\u1EE7a ngh\u1EC1 g\u1ED1m c\u1ED5 Vi\u1EC7t Nam, v\u1EEBa
    mang gi\xE1 tr\u1ECB s\u1EED d\u1EE5ng v\u1EEBa c\xF3 \xFD ngh\u0129a ngh\u1EC7
    thu\u1EADt v\xE0 t\xE2m linh."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4ef25422120e36b479b67ce815335d25, type: 2}
