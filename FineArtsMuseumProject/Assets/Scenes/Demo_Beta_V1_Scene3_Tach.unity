    - target: {fileID: 6013434591141092753, guid: 4c5901bae86d1c240b3747dd39f32582,
        type: 3}
      propertyPath: m_text
      value: "V\u01B0\u1EDDn xu\xE2n Trung Nam B\u1EAFc c\u1EE7a Nguy\u1EC5n Gia
        Tr\xED \u0111\u01B0\u1EE3c c\xF4ng nh\u1EADn l\xE0 B\u1EA3o v\u1EADt qu\u1ED1c
        gia n\u0103m 2013, l\xE0 tuy\u1EC7t ph\u1EA9m s\u01A1n m\xE0i t\xE1i hi\u1EC7n
        kh\xF4ng kh\xED ng\xE0y xu\xE2n v\u1EDBi thi\u1EBFu n\u1EEF ba mi\u1EC1n
        trong trang ph\u1EE5c truy\u1EC1n th\u1ED1ng. T\xE1c ph\u1EA9m \u0111\u01B0\u1EE3c
        s\xE1ng t\xE1c t\u1EEB 1969 \u0111\u1EBFn 1989, v\u1EDBi 20 thi\u1EBFu n\u1EEF
        t\u01B0\u1EE3ng tr\u01B0ng cho 20 n\u0103m ho\xE0n th\xE0nh. \u0110\xE2y
        l\xE0 \u0111\u1EC9nh cao ngh\u1EC7 thu\u1EADt s\u01A1n m\xE0i c\u1EE7a Nguy\u1EC5n
        Gia Tr\xED, k\u1EBFt tinh n\u1EEDa th\u1EBF k\u1EF7 s\xE1ng t\u1EA1o, mang
        th\xF4ng \u0111i\u1EC7p v\u1EC1 th\u1ED1ng nh\u1EA5t v\xE0 h\u1EA1nh ph\xFAc
        cho qu\xEA h\u01B0\u01A1ng."
      objectReference: {fileID: 0}
