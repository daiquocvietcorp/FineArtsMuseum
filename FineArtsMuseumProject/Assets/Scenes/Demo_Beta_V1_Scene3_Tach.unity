--- !u!114 &5939318509245837232
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5939318509245837245}
  m_Enabled: 1
  m_EditorHideFlags: 0
